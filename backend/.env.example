# Persistent services (Vercel's filesystem is not a database)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# JWT/authentication
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
VERIFY_TOKEN_EXPIRE_MINUTES=30
VERIFY_RESEND_COOLDOWN_SECONDS=60

# Cross-origin cookie authentication
COOKIE_SECURE=true
CORS_ORIGINS=https://crackwatch.vercel.app
FRONTEND_URL=https://crackwatch.vercel.app

# Google authentication
GOOGLE_CLIENT_ID=

# Brevo verification email
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=AI Crack Detection

# Required because TensorFlow makes the Python function larger than 500 MB.
VERCEL_SUPPORT_LARGE_FUNCTIONS=1
